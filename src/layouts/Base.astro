---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { texts } from '../lib/texts';

const title = texts.meta_title;
const description = texts.meta_description;

// Social previews need an absolute image URL; PUBLIC_SITE_URL is set once the domain exists
const siteUrl = import.meta.env.PUBLIC_SITE_URL;
const ogImage = siteUrl ? new URL('/og.png', siteUrl).href : '/og.png';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={texts.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {siteUrl && <meta property="og:url" content={new URL('/', siteUrl).href} />}
  </head>
  <body>
    <div class="relative flex min-h-screen flex-col overflow-hidden">
      <div class="aurora" aria-hidden="true"></div>
      <slot />
    </div>
  </body>
</html>
