---
// Brush stroke under an accent phrase; the phrase never wraps.
---

<span class="relative z-0 inline-block whitespace-nowrap">
  <span><slot /></span>
  <svg
    aria-hidden="true"
    viewBox="0 0 300 44"
    preserveAspectRatio="none"
    class="absolute -bottom-0.5 -left-2 -z-1 h-[0.62em] w-[calc(100%+18px)] -rotate-[1.6deg] fill-marker stroke-marker opacity-95 lg:-left-2.5 lg:h-[0.6em] lg:w-[calc(100%+22px)]"
  >
    <path d="M6 24 C 18 15, 52 13, 96 12 C 150 10, 214 7, 262 6 C 280 5.5, 292 6, 296 9 C 299 13, 297 20, 293 26 C 289 32, 282 34, 266 35 C 214 37, 150 38, 96 39 C 60 40, 30 41, 14 40 C 6 39, 2 35, 3 30 C 3.5 27, 4.5 25.5, 6 24 Z"></path>
    <path stroke="none" opacity="0.55" d="M262 30 C 276 29, 290 28, 298 33 C 290 37, 276 38, 262 37 Z"></path>
  </svg>
</span>
